extends "res://tests/sprint_005.gd"

func run() -> void:
	MobileInput.configure_enabled(true)
	check(DeveloperTools.available(), "editor requires explicit internal opt-in")
	game = load("res://game/main_game.tscn").instantiate()
	add_child(game)
	controller = game.get_node("StageController")
	check(await wait_for_stage("res://stages/main_menu/main_menu.tscn"), "internal main menu loads")
	tap_control(controller.get_child(0).find_child("StartButton", true, false))
	check(await wait_for_stage("res://stages/island/island.tscn"), "internal island loads")
	island = controller.get_child(0)
	player = island.get_node("Actors/Player")
	inventory = player.get_node("Managers/InventoryManager")
	var floor_body := StaticBody3D.new()
	var collision := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(100,2,100)
	collision.shape = box
	floor_body.add_child(collision)
	island.add_child(floor_body)
	floor_body.position = Vector3(500,98,0)
	player.global_position = Vector3(500,100,0)
	player.velocity = Vector3.ZERO
	await physics_frames(90)
	var stats: PlayerStatsManager = player.get_node("Managers/PlayerStatsManager")
	check(not DeveloperTools.invincible and not DeveloperTools.unlimited_needs and not DeveloperTools.flying and DeveloperTools.speed_multiplier == 1, "all cheats off and speed normal on spawn")
	check(MobileInput.buttons.has("developer") and not MobileInput.buttons.has("fly_up"), "internal entry visible; flight controls absent by default")
	stats.change_health(-10)
	check(stats.current_health == 90, "normal damage preserved by default")
	DeveloperTools.set_cheat("invincible", true)
	stats.change_health(-1000)
	check(stats.current_health == 90, "invincibility blocks fatal damage without healing")
	stats.change_health(5)
	check(stats.current_health == 95, "positive healing remains functional")
	DeveloperTools.set_cheat("invincible", false)
	stats.change_health(-5)
	check(stats.current_health == 90, "damage resumes after invincibility disabled")
	DeveloperTools.set_cheat("needs", true)
	stats.change_energy(-1000)
	check(stats.current_energy == 100 and stats.current_health == 90, "unlimited needs prevents exhaustion and exhaustion damage")
	DeveloperTools.set_cheat("needs", false)
	stats.change_energy(-10)
	check(stats.current_energy == 90, "energy consumption resumes when disabled")
	check(DeveloperTools.give_item(-1, 5) == 0 and DeveloperTools.give_item(0, -1) == 0, "invalid keys and quantities rejected")
	var hotbar_before := inventory.hotbar.duplicate()
	check(DeveloperTools.give_item(ItemConfig.Keys.Stick, 5) == 5 and inventory.inventory.count(ItemConfig.Keys.Stick) == 5, "developer resources use real inventory slots")
	check(DeveloperTools.give_item(ItemConfig.Keys.Axe, 1) == 1, "equipment can be given through the same safe interface")
	check(DeveloperTools.give_item(ItemConfig.Keys.Stone, 999999) == 22, "oversized grant clamps to free inventory capacity")
	var full := inventory.inventory.duplicate()
	check(DeveloperTools.give_item(ItemConfig.Keys.Fruit, 1) == 0 and inventory.inventory == full, "full inventory cannot be overwritten")
	check(inventory.hotbar == hotbar_before, "resource grants never overwrite equipment slots")
	DeveloperTools.set_speed(999)
	check(DeveloperTools.movement_multiplier() == 3, "speed clamps to mobile-safe maximum")
	DeveloperTools.set_speed(NAN)
	check(DeveloperTools.movement_multiplier() == 3, "nonfinite speed rejected")
	DeveloperTools.set_speed(2)
	var stick := MobileInput.joystick_center
	touch(0, stick, true)
	drag(0, stick-Vector2(0,MobileInput.joystick_radius),Vector2(0,-60))
	await physics_frames(12)
	check(absf(Vector2(player.velocity.x,player.velocity.z).length()-6) < .05, "actual grounded walking speed follows multiplier")
	touch(0,stick,false)
	await physics_frames(5)
	var ground := player.global_position
	var mask := player.collision_mask
	var layer_value := player.collision_layer
	var gravity_value := player.gravity
	var ceiling := StaticBody3D.new()
	var ceiling_collision := CollisionShape3D.new()
	var ceiling_shape := BoxShape3D.new()
	ceiling_shape.size = Vector3(50,1,50)
	ceiling_collision.shape = ceiling_shape
	ceiling.add_child(ceiling_collision)
	island.add_child(ceiling)
	ceiling.global_position = ground + Vector3.UP*3
	DeveloperTools.set_cheat("fly", true)
	check(MobileInput.buttons.has("fly_up") and MobileInput.buttons.has("fly_down"), "flight exposes two mobile vertical hold controls")
	touch(0,stick,true)
	drag(0,stick-Vector2(0,MobileInput.joystick_radius),Vector2(0,-60))
	touch(1,center("fly_up"),true)
	var look := MobileInput.safe_rect.position + MobileInput.safe_rect.size*Vector2(.7,.4)
	touch(2,look,true)
	var yaw := player.camera_rig.rotation.y
	drag(2,look+Vector2(25,5),Vector2(25,5))
	await physics_frames(20)
	check(player.global_position.y > ground.y+0.5, "mobile Up makes the colliding body fly upward")
	check(Vector2(player.velocity.x,player.velocity.z).length() > 1 and player.camera_rig.rotation.y != yaw, "joystick flight and camera work simultaneously with vertical finger")
	check(not MobileInput.pending.has("interact") and not MobileInput.pending.has("use_equipped_item"), "flight controls cannot leak world actions")
	await physics_frames(60)
	check(player.global_position.y < ground.y+1.65, "flight collides with overhead geometry instead of passing through")
	ceiling.queue_free()
	await physics_frames(2)
	touch(1,center("fly_up"),false)
	touch(3,center("fly_down"),true)
	await physics_frames(3)
	check(player.velocity.y < 0, "mobile Down descends")
	MobileInput.release_all()
	await physics_frames(3)
	check(player.velocity.is_zero_approx(), "releasing touches stops flight without lingering thrust")
	player.global_position += Vector3.UP*20
	DeveloperTools.set_cheat("fly", false)
	await physics_frames(30)
	check(player.is_on_floor() and player.global_position.distance_to(ground)<.3, "disabling flight returns to remembered grounded point")
	check(player.gravity == gravity_value and player.collision_mask == mask and player.collision_layer == layer_value, "flight never mutates gravity or collision configuration")
	check(not MobileInput.buttons.has("fly_up") and MobileInput.held.is_empty(), "disabling flight removes vertical controls and held inputs")
	player.global_position += Vector3(20,10,20)
	check(DeveloperTools.recover(), "stuck recovery accepts a clear grounded checkpoint")
	await physics_frames(30)
	check(player.is_on_floor() and player.global_position.distance_to(ground)<.3, "recovery clears velocity and returns safely")
	var spawn_before := DeveloperTools.spawn_position
	DeveloperTools.spawn_position = ground
	player.global_position += Vector3(10,10,10)
	check(DeveloperTools.recover(true), "explicit reset can use island spawn instead of a trapped last grounded point")
	await physics_frames(30)
	check(player.is_on_floor() and player.global_position.distance_to(ground)<.3, "spawn reset retains normal collision and grounding")
	DeveloperTools.spawn_position = spawn_before
	touch(4,center("developer"),true)
	touch(4,center("developer"),false)
	await physics_frames(2)
	check(DeveloperTools.panel.visible and MobileInput.frozen and not player.is_physics_processing(), "DEV touch opens panel and freezes gameplay")
	var view_yaw := player.camera_rig.rotation.y
	tap_control(DeveloperTools.toggles["invincible"],5)
	check(DeveloperTools.invincible, "touch-native developer toggle enables invincibility")
	check(player.camera_rig.rotation.y == view_yaw and MobileInput.pending.is_empty(), "panel touches cannot rotate camera or activate items")
	tap_control(DeveloperTools.toggles["needs"],6)
	check(DeveloperTools.unlimited_needs and stats.current_energy == 100, "touch-native needs toggle refills real energy meter")
	var give_button: Button
	for button in DeveloperTools.panel.find_children("*", "Button", true, false):
		if button.text == "Give 5": give_button = button
	tap_control(give_button,7)
	check(inventory.inventory == full and DeveloperTools.feedback.text.contains("Added 0"), "touch resource grant reports full inventory without overwriting it")
	var slider_point := DeveloperTools.speed_slider.get_global_transform_with_canvas() * Vector2(DeveloperTools.speed_slider.size.x*.99, DeveloperTools.speed_slider.size.y/2)
	touch(8,slider_point,true)
	var menu_background := MobileInput.safe_rect.position + MobileInput.safe_rect.size*Vector2(.1,.8)
	touch(9,menu_background,true)
	drag(9,menu_background+Vector2(30,0),Vector2(30,0))
	touch(8,slider_point,false)
	touch(9,menu_background,false)
	check(DeveloperTools.speed_multiplier == 3 and player.camera_rig.rotation.y == view_yaw, "touch speed slider works while another menu finger cannot rotate camera")
	if OS.get_cmdline_user_args().has("--capture") and DisplayServer.get_name() != "headless":
		await RenderingServer.frame_post_draw
		get_viewport().get_texture().get_image().save_png("/workspace/artifacts/kawanan-sprint007/developer-panel.png")
	DeveloperTools.toggle_panel()
	check(not MobileInput.frozen and player.is_physics_processing(), "closing panel resumes gameplay")
	DeveloperTools.set_cheat("needs",true)
	DeveloperTools.set_cheat("fly",true)
	DeveloperTools.reset_cheats()
	await physics_frames(30)
	check(not DeveloperTools.is_flying() and not DeveloperTools.damage_protected() and not DeveloperTools.needs_protected() and DeveloperTools.movement_multiplier()==1, "disable ALL restores every normal gameplay modifier")
	check(DeveloperTools.status.text.contains("Cheats OFF"), "status clearly reports no active cheats")
	MobileInput.pending["jump"] = true
	await physics_frames(3)
	check(player.velocity.y>0, "normal jumping works after disabling all cheats")
	await physics_frames(90)
	check(player.is_on_floor(), "normal gravity and landing work after flight")
	DeveloperTools.set_cheat("invincible",true)
	controller.start_stage_change_sequence(StageConfig.Keys.Credits)
	check(await wait_for_stage("res://stages/credits/credits_stage.tscn"), "stage transition with cheats active completes")
	check(DeveloperTools.player == null and not DeveloperTools.invincible and not DeveloperTools.panel.visible, "stage unload clears player, panel and cheats")
	print("SPRINT 007: ",checks," checks, ",failures," failures")
	game.get_node("MusicController").stop()
	game.queue_free()
	await get_tree().create_timer(.3).timeout
	get_tree().quit(0 if failures==0 else 1)
